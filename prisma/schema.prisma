generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  role      String
  state     String
  createdAt DateTime @default(now())
}

model Demography {
  id         Int     @id @default(autoincrement())
  zone       String?
  state      String?
  year       Int?
  page       String?
  indicator  String?
  value      Int?
  category_1 String?
  category_2 String?
}

model Demography_LGA {
  id                   Int     @id @default(autoincrement())
  zone                 String?
  state                String?
  year                 Int?
  page                 String?
  lga                  String?
  lga_population       Float?
  number_of_wards      Int?
  hard_to_reach_wards  Int?
  hard_to_reach_colour String?
  health_facilities    Int?
  density              Int?
}

model Health_Facilities {
  id               Int     @id @default(autoincrement())
  zone             String?
  state            String?
  year             Int?
  page             String?
  indicator        String?
  level            String?
  ownership        String?
  value            Int?
  state_population Int?
}

model Health_Fac_Service_Provision {
  id                Int     @id @default(autoincrement())
  zone              String?
  state             String?
  year              Int?
  page              String?
  service_provision String?
  number            Int?
  percentage        Float?
}

model HRH {
  id        Int     @id @default(autoincrement())
  zone      String?
  state     String?
  year      Int?
  page      String?
  indicator String?
  values    Int?
  density   Float?
  target    Float?
}

model Health_Training_Institutions {
  id          Int     @id @default(autoincrement())
  zone        String?
  state       String?
  year        Int?
  page        String?
  institution String?
  ownership   String?
  value       Int?
}

model Admission_Quota {
  id        Int     @id @default(autoincrement())
  zone      String?
  state     String?
  year      Int?
  page      String?
  indicator String?
  faculty   String?
  value     Int?
}

model Insurance_Coverage {
  id            Int     @id @default(autoincrement())
  zone          String?
  state         String?
  year          Int?
  page          String?
  indicator     String?
  enrollee_type String?
  value         Int?
}

model Scorecards {
  id        Int     @id @default(autoincrement())
  zone      String?
  state     String?
  year      Int?
  page      String?
  name      String?
  indicator String?
  value     Int?
  round     String?
}

model Access_Service_Utilization {
  id            Int     @id @default(autoincrement())
  zone          String?
  state         String?
  calendar_year Int?
  data_year     String?
  page          String?
  indicator     String?
  source        String?
  value         Float?
  target        Float?
}

model Health_Outcomes {
  id            Int     @id @default(autoincrement())
  zone          String?
  state         String?
  calendar_year Int?
  data_year     String?
  page          String?
  indicator     String?
  source        String?
  value         Float?
  target        Float?
}

model HFin {
  id                     Int     @id @default(autoincrement())
  zone                   String?
  state                  String?
  year                   Int?
  Page                   String?
  category               String?
  indicator              String?
  exp_type               String?
  program_classification String?
  value                  Float?
}

model Partners_Mapping {
  id                Int     @id @default(autoincrement())
  zone              String?
  state             String?
  year              Int?
  page              String?
  partner           String?
  intervention_area String?
  coverage_area     Int?
}

model Flagship_Project {
  id          Int     @id @default(autoincrement())
  zone        String?
  state       String?
  year        Int?
  page        String?
  project     String?
  description String?
}

model NDHS {
  id        Int     @id @default(autoincrement())
  zone      String?
  state     String?
  year      Int?
  category  String?
  indicator String?
  value     Float?
  source    String?
}

model LGA_Per_Capita {
  id         Int     @id @default(autoincrement())
  zone       String?
  state      String?
  year       Int?
  lga        String?
  population Float?
  per_capita Int?
  indicator  String?
  budget     Float?
}

model Presidential_Indicators {
  id        Int     @id @default(autoincrement())
  zone      String?
  state     String?
  year      Int?
  indicator String?
  value     Int?
}
